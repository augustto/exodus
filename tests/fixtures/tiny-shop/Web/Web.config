<configuration>
  <connectionStrings>
    <add name="Shop" connectionString="Data Source=dbsrv;Initial Catalog=Shop;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.serviceModel>
    <client>
      <endpoint address="http://api.intranet/Orders.svc" binding="basicHttpBinding" contract="IOrders" />
    </client>
  </system.serviceModel>
</configuration>
